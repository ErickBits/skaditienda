# ─────────────────────────────────────────────────────────────
# Skaditienda · Variables de entorno
# Copia este archivo como:
#   .env.development  → desarrollo local (npm run dev)
#   .env.production   → producción (npm start). En Hostinger también
#                       puedes definirlas en el panel de la app Node.js.
# NUNCA subas los archivos .env reales al repositorio.
# ─────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=3000

# URL pública desde la que el navegador abre la tienda (sin "/" final).
# Desarrollo: el servidor de Vite (http://localhost:5173)
# Producción: https://skaditienda.com
APP_URL=http://localhost:5173

# MySQL / MariaDB (en Hostinger: Bases de datos → MySQL; el host suele ser localhost)
DATABASE_URL=mysql://skadi:skadi@localhost:3306/skaditienda
# false | true (TLS verificando certificado) | no-verify (TLS sin verificar, solo si tu proveedor lo exige)
DATABASE_SSL=false

# Secreto para firmar la sesión del administrador (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres

# Wompi (Panel de comercios → Desarrolladores)
# sandbox → llaves pub_test_ / test_integrity_ / test_events_
# production → llaves pub_prod_ / prod_integrity_ / prod_events_
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# Carpeta (relativa a la raíz del proyecto) donde se guardan las imágenes subidas
UPLOAD_DIR=server/uploads
